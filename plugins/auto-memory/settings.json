{
  "statusLine": {
    "type": "command",
    "command": "if [ -f ~/.claude/statusline.py ]; then python3 ~/.claude/statusline.py; fi",
    "refreshInterval": 30
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/session-end.py ]; then python3 ~/.claude/hooks/session-end.py; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/post-tool-edit.py ]; then python3 ~/.claude/hooks/post-tool-edit.py; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.claude/hooks/session-start.py ]; then python3 ~/.claude/hooks/session-start.py; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "_why": "Read-only commands only, pinned to exact forms where a flag would change that. A prefix rule (:*) also allows every flag of the command: git branch:* would allow -D, rg:* would allow --pre <program>, and build tools such as cargo check run the repository's own code. This fragment is merged into the global ~/.claude/settings.json, so a rule granted here applies in every repo on the machine, including one just cloned. Allowlist build and test runners per project instead. Remaining risks: PERMISSIONS-WARNING.md.",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git worktree list)",
      "Bash(git blame:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(npm ls:*)"
    ]
  }
}
